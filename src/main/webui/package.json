{
	"name": "quarkus-mantleui",
	"version": "10.10.7",
	"description": "Quarkus monorepo demonstrating Quarkus REST server with Mantle UI client.",
	"homepage": ".",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/melloware/quarkus-primereact.git"
	},
	"license": "MIT",
	"dependencies": {
		"@mantle-ui/flex": "^3.4.1",
		"@mantle-ui/icons": "^7.1.1",
		"@mantle-ui/react": "10.11.0",
		"@tanstack/react-form": "1.33.3",
		"@tanstack/react-query": "5.101.4",
		"axios": "1.19.0",
		"primelocale": "2.4.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router-dom": "7.18.2",
		"react-transition-group": "4.4.5",
		"react-use-websocket": "4.13.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tanstack/react-query-devtools": "5.101.4",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/react-router-dom": "5.3.3",
		"@types/react-transition-group": "4.4.12",
		"@vitejs/plugin-react": "6.0.5",
		"core-js": "3.50.0",
		"cross-env": "10.1.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"orval": "8.24.0",
		"prettier": "3.9.6",
		"sass": "1.102.0",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"wait-on": "^9.1.0"
	},
	"scripts": {
		"format": "prettier --write \"{src,__tests__}/**/*.{ts,tsx}\"",
		"codegen": "wait-on -d 1000 ./openapi.yaml && orval && npm run format",
		"start": "npm run dev",
		"dev": "npm run codegen && vite",
		"build": "npm run codegen && vite build",
		"preview": "vite preview",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
	}
}
