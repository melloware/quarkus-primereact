{
	"name": "quarkus-primereact",
	"version": "10.9.8",
	"description": "Quarkus monorepo demonstrating Quarkus REST server with PrimeReact UI client.",
	"homepage": ".",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/melloware/quarkus-primereact.git"
	},
	"license": "MIT",
	"dependencies": {
		"@tanstack/react-form": "1.33.1",
		"@tanstack/react-query": "5.101.2",
		"axios": "1.18.1",
		"primeflex": "4.0.0",
		"primeicons": "7.0.0",
		"primelocale": "2.4.0",
		"primereact": "10.9.8",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router-dom": "7.18.1",
		"react-transition-group": "4.4.5",
		"react-use-websocket": "4.13.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tanstack/react-query-devtools": "5.101.2",
		"@types/node": "25.9.5",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/react-router-dom": "5.3.3",
		"@types/react-transition-group": "4.4.12",
		"@vitejs/plugin-react": "6.0.3",
		"core-js": "3.49.0",
		"cross-env": "10.1.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"orval": "8.21.0",
		"prettier": "3.9.5",
		"sass": "1.101.0",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"wait-on": "^9.0.10"
	},
	"scripts": {
		"format": "prettier --write \"{src,__tests__}/**/*.{ts,tsx}\"",
		"codegen": "wait-on -d 1000 ./openapi.yaml && orval && npm run format",
		"start": "npm run dev",
		"dev": "npm run codegen && vite",
		"build": "npm run codegen && vite build",
		"preview": "vite preview",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
	}
}
